#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.0.2"
APP="xray-tui"
UPDATE_URL="${XRAY_TUI_UPDATE_URL:-https://raw.githubusercontent.com/RxtPR/xray-tui/main/xray-tui}"
ETC_DIR="${XRAY_TUI_ETC:-/etc/xray-tui}"
PROFILE_DIR="$ETC_DIR/profiles"
SUB_DIR="$ETC_DIR/subscriptions"
ACTIVE_LINK="$ETC_DIR/active.json"
ACTIVE_NAME="$ETC_DIR/active-profile"
MODE_FILE="$ETC_DIR/mode"
SERVICE="xray-tui.service"
TUN_NAME="xray0"
TUN_TABLE="20220"
TUN_STATE="/run/xray-tui/tun.state"
SOCKS_PORT="${XRAY_TUI_SOCKS_PORT:-10808}"
HTTP_PORT="${XRAY_TUI_HTTP_PORT:-10809}"
DEFAULT_MODE="${XRAY_TUI_DEFAULT_MODE:-tun}"
[[ "$DEFAULT_MODE" == "proxy" || "$DEFAULT_MODE" == "tun" ]] || DEFAULT_MODE="tun"
SYSTEM_LOCALE="${XRAY_TUI_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}"
case "${SYSTEM_LOCALE,,}" in ru*) UI_LANG="ru" ;; *) UI_LANG="en" ;; esac

say() { printf '%s\n' "$*"; }
err() { printf 'xray-tui: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
l10n() {
  local ru="$1" en="$2" format
  shift 2
  if [[ "$UI_LANG" == "ru" ]]; then format="$ru"; else format="$en"; fi
  printf "$format" "$@"
}

